    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "wages-017",
   "metadata": {},
   "source": [
    "## 9. Load five years of BLS wages\n",
    "\n",
    "Source: https://www.bls.gov/oes/tables.htm . Read each Excel file once, keeping all five metros and the relevant occupation codes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "wages-018",
   "metadata": {},
   "outputs": [],
   "source": [
    "occupation_codes = [\n",
    "    \"41-2011\",  # Cashiers\n",
    "    \"41-2031\",  # Retail salespersons\n",
    "    \"35-3023\",  # Fast food and counter workers\n",
    "    \"35-3031\",  # Waiters and waitresses\n",
    "    \"35-9031\",  # Restaurant hosts\n",
    "    \"31-1120\",  # Home health and personal care aides\n",
    "    \"39-9011\",  # Childcare workers\n",
    "    \"53-7062\",  # Laborers and material movers\n",
    "    \"53-7065\",  # Stockers and order fillers\n",
    "    \"31-9092\",  # Medical assistants\n",
    "    \"25-2012\",  # Kindergarten teachers\n",
    "    \"25-2021\",  # Elementary school teachers\n",
    "    \"25-2022\",  # Middle school teachers\n",
    "    \"25-2031\",  # Secondary school teachers\n",
    "    \"29-1141\",  # Registered nurses\n",
    "    \"47-2111\",  # Electricians\n",
    "    \"13-2011\",  # Accountants and auditors\n",
    "    \"15-1252\",  # Software developers\n",
    "]\n",
    "\n",
    "\n",
    "parts = []\n",
    "for year in range(2021, 2026):\n",
    "    print(f\"Reading BLS {year}...\", flush=True)\n",
    "    data = pd.read_excel(\n",
    "        f\"/content/MSA_M{year}_dl.xlsx\",\n",
    "        sheet_name=0,\n",
    "        usecols=[\n",
    "            \"AREA\", \"AREA_TITLE\", \"NAICS\", \"OWN_CODE\",\n",
    "            \"OCC_CODE\", \"OCC_TITLE\", \"TOT_EMP\", \"A_MEDIAN\"\n",
    "        ],\n",
    "        dtype={\"AREA\": str, \"OCC_CODE\": str}\n",
    "    )\n",
    "    keep = (\n",
    "        data[\"AREA\"].isin([\"34900\", \"41860\", \"41940\", \"42220\", \"46700\"])\n",
    "        & data[\"OCC_CODE\"].isin(occupation_codes)\n",
    "        & pd.to_numeric(data[\"NAICS\"], errors=\"coerce\").eq(0)\n",
    "        & pd.to_numeric(data[\"OWN_CODE\"], errors=\"coerce\").eq(1235)\n",
    "    )\n",
    "    selected = data.loc[keep].copy()\n",
    "    selected[\"year\"] = year\n",
    "    parts.append(selected)\n",
    "\n",
    "history_all = pd.concat(parts, ignore_index=True)\n",
    "assert not history_all.duplicated([\"year\", \"AREA\", \"OCC_CODE\"]).any()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "wages-019",
   "metadata": {},
   "source": [
    "## 10. Calculate historical wage growth\n",
    "\n",
    "Average valid consecutive-year changes, requiring at least two. The 2024 transitions for three renamed metros remain excluded pending boundary review. Missing and suppressed wages are not zero."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "wages-020",
   "metadata": {},
   "outputs": [],
   "source": [
    "history_all[\"annual_median\"] = pd.to_numeric(\n",
    "    history_all[\"A_MEDIAN\"].astype(str)\n",
    "    .str.replace(\",\", \"\", regex=False),\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "history_all = history_all.sort_values(\n",
    "    [\"AREA\", \"OCC_CODE\", \"year\"]\n",
    ")\n",
    "\n",
    "groups = history_all.groupby([\"AREA\", \"OCC_CODE\"])\n",
    "previous_pay = groups[\"annual_median\"].shift()\n",
    "previous_year = groups[\"year\"].shift()\n",
    "\n",
    "history_all[\"wage_growth\"] = (\n",
    "    history_all[\"annual_median\"] / previous_pay - 1\n",
    ").where(\n",
    "    (history_all[\"year\"] - previous_year == 1)\n",
    "    & previous_pay.gt(0)\n",
    "    & history_all[\"annual_median\"].gt(0)\n",
    ")\n",
    "\n",
    "# Temporarily exclude transitions where metro names changed\n",
    "pending_boundary_check = (\n",
    "    history_all[\"year\"].eq(2024)\n",
    "    & history_all[\"AREA\"].isin([\"41860\", \"42220\", \"46700\"])\n",
    ")\n",
    "history_all.loc[pending_boundary_check, \"wage_growth\"] = float(\"nan\")\n",
    "\n",
    "growth_by_occupation = (\n",
    "    history_all.groupby([\"AREA\", \"OCC_CODE\"], as_index=False)\n",
    "    .agg(\n",
    "        wage_growth=(\"wage_growth\", \"mean\"),\n",
    "        n_growth_years=(\"wage_growth\", \"count\")\n",
    "    )\n",
    ")\n",
    "\n",
    "# Require at least two valid annual changes\n",
    "growth_by_occupation.loc[\n",
    "    growth_by_occupation[\"n_growth_years\"] < 2,\n",
    "    \"wage_growth\"\n",
    "] = float(\"nan\")\n",
    "\n",
    "history_all.to_csv(\n",
    "    output_dir / \"bls_wage_history_all_metros.csv\", index=False\n",
    ")\n",
    "\n",
    "print(\"Growth coverage by metro:\")\n",
    "display(\n",
    "    growth_by_occupation.groupby(\"AREA\")\n",
    "    .agg(\n",
    "        occupations=(\"OCC_CODE\", \"size\"),\n",
    "        usable_growth_estimates=(\"wage_growth\", \"count\")\n",
    "    )\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "wages-021",
   "metadata": {},
   "source": [
    "## 11. Add projected pay\n",
    "\n",
    "Apply historical growth to Indeed median pay. Broad jobs use equal weights across mapped occupations, requiring all components. These are projection assumptions, not individual raises."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "wages-022",
   "metadata": {},
   "outputs": [],
   "source": [
    "job_codes = {\n",
    "    \"Accountant\": [\"13-2011\"],\n",
    "    \"Software engineer\": [\"15-1252\"],\n",
    "    \"K–12 teacher\": [\"25-2012\", \"25-2021\", \"25-2022\", \"25-2031\"],\n",
    "    \"Registered nurse\": [\"29-1141\"],\n",
    "    \"Home health aide\": [\"31-1120\"],\n",
    "    \"Medical assistant\": [\"31-9092\"],\n",
    "    \"Food service worker\": [\"35-3023\", \"35-3031\", \"35-9031\"],\n",
    "    \"Childcare worker\": [\"39-9011\"],\n",
    "    \"Cashier\": [\"41-2011\"],\n",
    "    \"Retail sales\": [\"41-2031\"],\n",
    "    \"Electrician\": [\"47-2111\"],\n",
    "    \"Warehouse worker\": [\"53-7062\", \"53-7065\"]\n",
    "}\n",
    "\n",
    "mapping = pd.DataFrame(\n",
    "    [(job, code) for job, codes in job_codes.items() for code in codes],\n",
    "    columns=[\"job\", \"OCC_CODE\"]\n",
    ")\n",
    "\n",
    "\n",
    "county_to_metro = {\n",
    "    \"San Francisco\": \"41860\",\n",
    "    \"Alameda\": \"41860\",\n",
    "    \"Contra Costa\": \"41860\",\n",
    "    \"San Mateo\": \"41860\",\n",
    "    \"Marin\": \"41860\",\n",
    "    \"Santa Clara\": \"41940\"\n",
    "}\n",
    "\n",
    "\n",
    "# Rebuild job-level growth using all five metros\n",
    "job_growth = (\n",
    "    mapping.merge(\n",
    "        growth_by_occupation[[\"AREA\", \"OCC_CODE\", \"wage_growth\"]],\n",
    "        on=\"OCC_CODE\"\n",
    "    )\n",
    "    .groupby([\"job\", \"AREA\"], as_index=False)\n",
    "    .agg(\n",
    "        wage_growth=(\"wage_growth\", \"mean\"),\n",
    "        n_codes_available=(\"wage_growth\", \"count\")\n",
    "    )\n",
    ")\n",
    "\n",
    "job_growth[\"n_codes_expected\"] = job_growth[\"job\"].map(\n",
    "    {job: len(codes) for job, codes in job_codes.items()}\n",
    ")\n",
    "\n",
    "# Leave growth blank if any required occupation is unavailable\n",
    "incomplete = (\n",
    "    job_growth[\"n_codes_available\"] != job_growth[\"n_codes_expected\"]\n",
    ")\n",
    "job_growth.loc[incomplete, \"wage_growth\"] = float(\"nan\")\n",
    "\n",
    "county_to_metro.update({\n",
    "    \"Napa\": \"34900\",\n",
    "    \"Sonoma\": \"42220\",\n",
    "    \"Solano\": \"46700\"\n",
    "})\n",
    "\n",
    "# Start from the wage summary to avoid duplicate growth columns\n",
    "wages_projected = wages_full.copy()\n",
    "wages_projected[\"county\"] = wages_projected[\"city\"].map(city_to_county)\n",
    "wages_projected[\"AREA\"] = wages_projected[\"county\"].map(county_to_metro)\n",
    "\n",
    "wages_projected = wages_projected.merge(\n",
    "    job_growth[[\"job\", \"AREA\", \"wage_growth\"]],\n",
    "    on=[\"job\", \"AREA\"],\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\"\n",
    ")\n",
    "\n",
    "wages_projected[\"projected_pay\"] = (\n",
    "    wages_projected[\"median_pay\"]\n",
    "    * (1 + wages_projected[\"wage_growth\"])\n",
    ").round(2)\n",
    "\n",
    "wages_projected.to_csv(\n",
    "    output_dir / \"wages_by_job_city_DRAFT.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"Saved updated draft.\")\n",
    "print(\"\\nJob/county combinations missing growth:\")\n",
    "display(\n",
    "    wages_projected.loc[\n",
    "        wages_projected[\"wage_growth\"].isna(),\n",
    "        [\"job\", \"county\"]\n",
    "    ].drop_duplicates()\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "wages-023",
   "metadata": {},
   "source": [
    "## 12. Load housing, audit geography, and calculate rent burden\n",
    "\n",
    "Use Person 1's typical rent and home value estimates. Preserve the seven-row exclusion log. Join city wages to housing ZIPs. Rent burden = 12 × monthly rent / annual pay; values above 100% remain."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "wages-024",
   "metadata": {},
   "outputs": [],
   "source": [
    "housing = pd.read_csv(\n",
    "    \"/content/albert_housing_by_zip.csv\",\n",
    "    dtype={\"zipcode\": str}\n",
    ")\n",
    "\n",
    "print(housing.columns.tolist())\n",
    "display(housing.head())\n",
    "exclusion_reasons = {\n",
    "    \"93463\": \"Outside Bay Area: Santa Barbara County\",\n",
    "    \"95377\": \"Outside Bay Area: San Joaquin County\",\n",
    "    \"95391\": \"Outside Bay Area: San Joaquin County\",\n",
    "    \"95618\": \"Outside Bay Area: Yolo County\",\n",
    "    \"95642\": \"Incorrect city/county: Jackson, Amador County\",\n",
    "    \"95694\": \"Outside Bay Area: Yolo County\",\n",
    "    \"96045\": \"Unverified ZIP; excluded pending correction\"\n",
    "}\n",
    "\n",
    "housing_checked = housing.copy()\n",
    "housing_checked[\"zipcode\"] = (\n",
    "    housing_checked[\"zipcode\"].astype(\"string\").str.strip().str.zfill(5)\n",
    ")\n",
    "\n",
    "excluded = housing_checked.loc[\n",
    "    housing_checked[\"zipcode\"].isin(exclusion_reasons)\n",
    "].copy()\n",
    "excluded[\"exclusion_reason\"] = excluded[\"zipcode\"].map(exclusion_reasons)\n",
    "\n",
    "housing_fixed = housing_checked.loc[\n",
    "    ~housing_checked[\"zipcode\"].isin(exclusion_reasons)\n",
    "].copy()\n",
    "\n",
    "assert housing_fixed[\"zipcode\"].is_unique\n",
    "\n",
    "housing_fixed.to_csv(\n",
    "    output_dir / \"housing_by_zip_corrected.csv\", index=False\n",
    ")\n",
    "excluded.to_csv(\n",
    "    output_dir / \"housing_geography_exclusions.csv\", index=False\n",
    ")\n",
    "\n",
    "# Rebuild the join using corrected housing\n",
    "h = housing_fixed.copy()\n",
    "w = wages_projected.copy()\n",
    "\n",
    "for table in [h, w]:\n",
    "    table[\"city_key\"] = (\n",
    "        table[\"city\"].astype(\"string\").str.strip().str.casefold()\n",
    "    )\n",
    "\n",
    "assert not w.duplicated([\"job\", \"city_key\"]).any()\n",
    "\n",
    "burden = h.merge(\n",
    "    w.drop(columns=[\"city\", \"county\"]),\n",
    "    on=\"city_key\",\n",
    "    how=\"left\",\n",
    "    indicator=True\n",
    ")\n",
    "\n",
    "rent = pd.to_numeric(burden[\"typical_rent\"], errors=\"coerce\")\n",
    "pay = pd.to_numeric(burden[\"median_pay\"], errors=\"coerce\")\n",
    "\n",
    "burden[\"rent_burden\"] = (12 * rent / pay).where(\n",
    "    rent.gt(0) & pay.gt(0)\n",
    ")\n",
    "\n",
    "rent_draft = burden.loc[burden[\"job\"].notna()].copy()\n",
    "rent_draft.to_csv(\n",
    "    output_dir / \"rent_burden_by_job_zip_DRAFT.csv\", index=False\n",
    ")\n",
    "\n",
    "print(\"Housing ZIPs retained:\", len(housing_fixed))\n",
    "print(\"Housing rows excluded:\", len(excluded))\n",
    "print(\"Corrected housing, exclusion log, and rent draft saved.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "wages-025",
   "metadata": {},
   "source": [
    "## 13. Calculate ownership gap\n",
    "\n",
    "Assume 20% down, a 30-year mortgage, and principal and interest equal to 30% of gross income. The user-reported 7.11% rate dated November 12, 2026 needs independent verification. Taxes, insurance, HOA fees, maintenance, and down-payment affordability are excluded."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "wages-026",
   "metadata": {},
   "outputs": [],
   "source": [
    "# User-reported Freddie Mac 30-year fixed rate:\n",
    "# 7.11%, released November 12, 2026\n",
    "# Source: https://www.freddiemac.com/pmms\n",
    "annual_rate = 0.0711\n",
    "monthly_rate = annual_rate / 12\n",
    "n_payments = 30 * 12\n",
    "\n",
    "result = rent_draft.copy()\n",
    "\n",
    "home_value = pd.to_numeric(\n",
    "    result[\"typical_home_value\"], errors=\"coerce\"\n",
    ")\n",
    "pay = pd.to_numeric(result[\"median_pay\"], errors=\"coerce\")\n",
    "\n",
    "# Assume 20% down; finance the remaining 80%\n",
    "loan = home_value * 0.80\n",
    "\n",
    "result[\"monthly_mortgage_pi\"] = (\n",
    "    loan * monthly_rate\n",
    "    / (1 - (1 + monthly_rate) ** (-n_payments))\n",
    ").where(home_value.gt(0))\n",
    "\n",
    "result[\"income_needed_to_buy\"] = (\n",
    "    result[\"monthly_mortgage_pi\"] * 12 / 0.30\n",
    ")\n",
    "\n",
    "result[\"ownership_gap\"] = (\n",
    "    result[\"income_needed_to_buy\"] / pay\n",
    ").where(pay.gt(0))\n",
    "\n",
    "# Save required deliverable\n",
    "result[\n",
    "    [\"job\", \"zipcode\", \"rent_burden\", \"ownership_gap\"]\n",
    "].to_csv(\n",
    "    output_dir / \"burden_by_job_zip.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "# Save supporting calculations and quality flags\n",
    "result.to_csv(\n",
    "    output_dir / \"burden_by_job_zip_details.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"Saved burden_by_job_zip.csv and supporting details.\")\n",
    "\n",
    "display(\n",
    "    result[\n",
    "        [\"job\", \"zipcode\", \"city\", \"median_pay\",\n",
    "         \"rent_burden\", \"ownership_gap\"]\n",
    "    ].head(15)\n",
    ")"
   ]
  },
